{
  "name": "schemasketch",
  "description": "Design, edit, validate, import and export database diagrams with SchemaSketch's MCP server: SQL DDL, Laravel migrations and Eloquent models, Mermaid and PlantUML.",
  "version": "1.3.0",
  "author": {
    "name": "SchemaSketch",
    "url": "https://schemasketch.dev"
  },
  "homepage": "https://schemasketch.dev",
  "repository": "https://github.com/SchemaSketch-dev/schemasketch-skills",
  "license": "MIT",
  "keywords": [
    "database",
    "schema",
    "erd",
    "dbml",
    "sql",
    "laravel",
    "mermaid",
    "plantuml",
    "mcp"
  ],
  "icon": ".claude-plugin/icon.png",
  "privacyPolicyUrl": "https://schemasketch.dev/privacy",
  "userConfig": {
    "schemasketch_token": {
      "type": "string",
      "title": "SchemaSketch token",
      "description": "Create one at schemasketch.dev: open the app menu and choose Connect AI agent.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "schemasketch": {
      "type": "http",
      "url": "https://mcp.schemasketch.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.schemasketch_token}"
      }
    }
  }
}
